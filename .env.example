# Primary mode: real Qloo with no LLM. Start only after its smoke checks pass.
# Use npm run start:fixture for the separate offline teaching demo.
SHELFBRIDGE_MODE=qloo_only
PORT=4318
HOST=127.0.0.1
QLOO_API_KEY=<QLOO_KEY_FROM_SECRET_STORE>
# Endpoint supplied by the hackathon organizers; exact trust is required by CLI.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Optional experimental two-provider mode only; unused by Qloo-only and MCP.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Optional: set only after live P00 has passed; see README.
QLOO_CONTRACT_APPROVED=false
QLOO_TRANSPORT=cli
# Optional absolute paths to a supported harness entry and Node 22.19+.
# Defaults use the project's ignored .tools directory; see docs/QLOO-CLI.md.
# QLOO_NODE_PATH=
# QLOO_CLI_ENTRY=
DAILY_PROVIDER_CALL_LIMIT=60
# On a public HTTPS backend, set true and the exact public website origin.
# For Vercel, use the stable production website origin.
PUBLIC_HTTPS=false
# PUBLIC_ORIGIN=https://shelfbridge.example.com
# Vercel Functions use a shared Upstash Redis database (Marketplace integration).
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Stable across redeployments; isolate preview databases/namespaces.
# SHELFBRIDGE_STATE_NAMESPACE=production
# MAX_SESSIONS=200
# MAX_NEW_SESSIONS_PER_HOUR=200
# Genuine current report JSON, stored only in Vercel server environment:
# SHELFBRIDGE_P00_REPORT=
# SHELFBRIDGE_QLOO_SMOKE_REPORT=
